# Copia in .env e compila.

# --- IA (opzionale: senza chiave il sito funziona, solo senza consigli) ---
OPENROUTER_API_KEY=
# Modelli preferiti per i due tipi di task. Lasciali vuoti per usare i pool di default.
OPENROUTER_JSON_MODELS=
OPENROUTER_ADVICE_MODELS=

# --- ricerca ---
# La ricerca procede in due ondate. La prima interroga gli operatori
# raggiungibili via HTTP, che rispondono in pochi secondi. La seconda quelli che
# richiedono un browser, molto piu' lenti: i loro risultati si aggiungono alla
# classifica man mano che arrivano. Oggi la seconda ondata resta vuota: nessun
# adapter e' tier 2, l'infrastruttura c'e' e aspetta il primo (`browser_base.py`).
FAST_BUDGET=20
SEARCH_TIME_BUDGET=90
# Richieste in volo in tutta la ricerca. Puo' essere alta, perche' il limite che
# protegge i singoli operatori e' un altro: quello per dominio, qui sotto.
SEARCH_MAX_CONCURRENCY=20
# Richieste al secondo verso lo stesso dominio: il vero collo di bottiglia della
# ricerca. Sono API JSON, non pagine da scaricare, e quattro al secondo restano
# un carico trascurabile. Abbassarlo a 1.0 rende ogni ricerca circa quattro
# volte piu' lenta: e' la manopola da muovere se un operatore risponde 429.
DOMAIN_RATE_LIMIT=4.0

# --- scraping ---
# Profilo TLS di curl_cffi (chrome, chrome131, safari, firefox...).
IMPERSONATE_PROFILE=chrome
# true per vedere il browser quando debugghi un adapter tier 2.
BROWSER_HEADLESS=true

# --- log ---
LOG_LEVEL=INFO
